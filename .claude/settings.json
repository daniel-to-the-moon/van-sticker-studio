{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci --ignore-scripts)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run build)",
      "Bash(node --experimental-strip-types --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh issue view:*)"
    ],
    "deny": [
      "Read(./.openai/**)",
      "Edit(./.openai/**)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.config/agent-apps/**)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm ci)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(node tools/bootstrap-github.mjs:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler versions deploy:*)",
      "Bash(npx wrangler secret:*)"
    ]
  }
}
